# --- Supabase (real RSVP + live guest wall) ---
# 1. Create a project at https://supabase.com
# 2. Project → Settings → API → copy these two values
# 3. Run the SQL at the top of src/lib/supabase.ts once
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=

# --- Resend (RSVP confirmation emails, future) ---
RESEND_API_KEY=

# --- Replicate (AI outfit visualizer, future) ---
REPLICATE_API_TOKEN=
